# ─── Coupa ────────────────────────────────────────────────────────────────────
# Your Coupa instance URL (no trailing slash)
COUPA_INSTANCE_URL=https://yourcompany.coupahost.com

# OAuth2 Client Credentials — from Coupa Admin > Setup > OAuth2/OIDC Clients
COUPA_CLIENT_ID=your_coupa_client_id
COUPA_CLIENT_SECRET=your_coupa_client_secret

# ─── Access codes ─────────────────────────────────────────────────────────────
# Passcode to enter the Finance Dashboard — server-side only, never exposed to browser
FINANCE_CODE=change_this_to_your_secret_code

# Passcode employees must enter to view restricted invoices — server-side only
RESTRICTED_CODE=change_this_to_restricted_code

# Comma-separated GL account keywords that trigger the restricted gate (server-side only)
# Any invoice whose account name contains one of these words requires the restricted code
RESTRICTED_GL_KEYWORDS=contractor,legal,contract labor,contract services

# ─── Slack (optional — for Send DM button in Finance Dashboard) ───────────────
# Bot token from https://api.slack.com/apps — needs chat:write + chat:write.customize + users:read.email scopes
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Comma-separated AP team names shown in the "Sending as" dropdown
NEXT_PUBLIC_AP_TEAM=Victoria Fung,Rosalina Lash,Shashank Hebbar

# Coupa instance URL exposed to client (for "open in Coupa" links)
NEXT_PUBLIC_COUPA_URL=https://changeorg.coupahost.com
